import { useState, useEffect } from "react";
import Button from "react-bootstrap/Button";
import Form from "react-bootstrap/Form";
import Modal from "react-bootstrap/Modal";
import Toast from "react-bootstrap/Toast";
import ToastContainer from "react-bootstrap/ToastContainer";
import ROSLIB from "roslib";
import "../../styles/App.css";
import "../../styles/modal.css";

function Example() {
  const [show, setShow] = useState(false);
  const [positionName, setPositionName] = useState("");
  const [buttonNames, setButtonNames] = useState([]);
  const [formData, setFormData] = useState({});
  const [positions, setPositions] = useState([]);
  const [latestPosition, setLatestPosition] = useState({});
  const [showToast, setShowToast] = useState(false);
  const [toastMessage, setToastMessage] = useState("");
  const [receivedData, setReceivedData] = useState([]); // State to hold received data

  useEffect(() => {
    const ros = new ROSLIB.Ros({
      url: "ws://192.168.0.45:9092",
    });

    ros.on("connection", () => {
      console.log("Connected to ROS");
    });

    ros.on("error", (error) => {
      console.error("Error connecting to ROS:", error);
    });

    ros.on("close", () => {
      console.log("Disconnected from ROS");
    });

    const poseTopic = new ROSLIB.Topic({
      ros,
      name: "/amcl_pose",
      messageType: "geometry_msgs/PoseWithCovarianceStamped",
    });

    poseTopic.subscribe((msg) => {
      setLatestPosition(msg);
      setPositions((prevPositions) => [...prevPositions, msg]);
      console.log("Received position:", msg);
    });

    // Fetch data from your backend
    fetch(`http://192.168.0.45:3001/api/data`)
      .then((response) => response.json())
      .then((data) => {
        console.log("Fetched data:", data);
        setReceivedData(data); // Update state with received data
        setButtonNames(data.map((item) => item.name)); // Update buttonNames with received data
      })
      .catch((error) => console.error("Error fetching data:", error));

    return () => {
      poseTopic.unsubscribe();
      ros.close();
    };
  }, []);

  const handleClose = () => setShow(false);
  const handleShow = () => {
    // Update formData with the latest position
    if (latestPosition.pose && latestPosition.pose.pose) {
      setFormData({
        field1: latestPosition.pose.pose.position.x,
        field2: latestPosition.pose.pose.position.y,
        field3: latestPosition.pose.pose.position.z,
        field4: latestPosition.pose.pose.orientation.w,
      });
    }
    setShow(true);
  };

  const handleInputChange = (e) => {
    setPositionName(e.target.value);
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (positionName.trim() !== "") {
      setButtonNames((prevButtonNames) => [...prevButtonNames, positionName]);
      setPositions((prevPositions) => [
        ...prevPositions,
        { name: positionName, ...latestPosition },
      ]);
      sendPositionData(positionName, latestPosition);
      setPositionName("");
      handleClose();
    }
  };

  const sendPositionData = (positionName, amclData) => {
    console.log(`Name - ${positionName}`);
    console.log(amclData);
    const ip = "192.168.0.45"; // Replace with actual IP
    const port = 3001; // Replace with actual port
    const url = `http://${ip}:${port}/save`;

    fetch(url, {
      method: "POST",
      body: JSON.stringify({
        positionName: positionName,
        amclData: amclData,
      }),
      headers: {
        "Content-Type": "application/json",
      },
    })
      .then((response) => {
        if (response.ok) {
          response.json();
          console.log("Inserted Into the DB");
          setToastMessage(
            `${positionName} successfully inserted into database`
          );
          setShowToast(true);
        }
      })
      .catch((error) => {
        console.error("Error sending data:", error);
      });
  };

  return (
    <>
      <Button onClick={handleShow} id="capture">
        Capture Position
      </Button>

      <Modal show={show} onHide={handleClose}>
        <Modal.Header closeButton>
          <Modal.Title>Taurus position capturing</Modal.Title>
        </Modal.Header>
        <Modal.Body>
          <Form onSubmit={handleSubmit}>
            <Form.Group className="mb-1" controlId="positionNameInput">
              <Form.Control
                type="input"
                placeholder="Enter Position Name"
                autoFocus
                value={positionName}
                onChange={handleInputChange}
              />
            </Form.Group>
            <Form.Group className="mb-3" controlId="xPoseInfo">
              <Form.Label>X: {formData.field1}</Form.Label>
            </Form.Group>
            <Form.Group className="mb-3" controlId="yPoseInfo">
              <Form.Label>Y: {formData.field2}</Form.Label>
            </Form.Group>
            <Form.Group className="mb-3" controlId="zPoseInfo">
              <Form.Label>Z: {formData.field3}</Form.Label>
            </Form.Group>
            <Form.Group className="mb-3" controlId="orientationInfo">
              <Form.Label>W: {formData.field4}</Form.Label>
            </Form.Group>
            <Form.Group>
              <Button variant="primary" type="submit">
                Submit
              </Button>
              <Button variant="secondary" onClick={handleClose}>
                Close
              </Button>
            </Form.Group>
          </Form>
        </Modal.Body>
      </Modal>

      {/* Display buttons from received data and new submissions */}
      <div
        className="received-buttons"
        style={{
          border: "1px solid black",
          borderRadius: "15px",
          width: "90vw",
          maxHeight: "250px",
          position: "relative",
          top: "90px",
          left: "70px",
          overflowY: "auto",
          overflowX: "hidden",
        }}
      >
        {buttonNames.map((name, index) => (
          <Button
            id="pos-buttons"
            style={{ width: "140px" }}
            key={index}
            // variant="secondary"
            className="mb-2"
            onClick={() => {
              console.log(`Button '${name}' clicked`);
            }}
          >
            {name}
          </Button>
        ))}
      </div>

      <ToastContainer position="bottom-end" className="p-3">
        <Toast
          onClose={() => setShowToast(false)}
          show={showToast}
          delay={3000}
          // autohide
        >
          <Toast.Header>
            <strong className="me-auto">Successfully Inserted into DB</strong>
          </Toast.Header>
          <Toast.Body>{toastMessage}</Toast.Body>
        </Toast>
      </ToastContainer>
    </>
  );
}

export default Example;
